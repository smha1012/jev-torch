# Copy to .env.local (gitignored) and fill in: cp .env.sample .env.local
# Training and the RunPod scripts load .env.local automatically; real environment variables win.

# Hugging Face: needs WRITE access. With a token, training pushes checkpoints to
# <your account>/<run name> every epoch and at the end (train.hf_push). Without it, nothing is uploaded.
HF_TOKEN=

# Weights & Biases (optional). Without it, runs are logged offline.
WANDB_API_KEY=
# WANDB_ENTITY=your-team
# TZ=KST-9                     # log timestamps in Korean time (the pod clock is UTC)
# HF_HOME=/workspace/hf_cache

# Personal config overrides, kept out of git (applied before --set; printed in the log). Examples:
# JEV_OVERRIDES="data.hf_dataset=your-name/jev-distill-corpus-v3 train.hf_push=your-name/jev-9b-v2"
JEV_OVERRIDES=
